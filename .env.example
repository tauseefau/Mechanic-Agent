# ---------------------------------------------------------------------------
# Workshop Voice Agent — environment template
# Copy to .env (gitignored) and fill in. NEVER commit the real .env.
# Every workshop-specific value also has a home in the Google Sheet Config tab;
# the Sheet wins at call time. Keep both in sync when onboarding.
# ---------------------------------------------------------------------------

# --- Workshop identity -----------------------------------------------------
# Shown in the greeting and quoted to callers. Edit in Config tab too.
WORKSHOP_NAME="Riverbend Auto Service"
WORKSHOP_PHONE="+61390000000"
WORKSHOP_ADDRESS="12 Example Rd, Melbourne VIC 3000"
TRANSFER_PHONE_NUMBER="+61400000000"     # emergencies / "give me a human"
TIMEZONE="Australia/Melbourne"
CURRENCY="AUD"
GST_PERCENT="10"

# --- Google Sheets ---------------------------------------------------------
# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=""

# --- Google Calendar -------------------------------------------------------
# Dedicated calendar, ID from Calendar settings -> Integrate calendar
CALENDAR_ID="xxxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com"

# --- Backend URL ----------------------------------------------------------
# The HTTPS endpoint Vapi calls. Two supported targets, same JSON contract:
#   a) Apps Script web app : https://script.google.com/macros/s/REPLACE_ME/exec
#   b) self-hosted runtime : https://diyyourdata.com/workshop-api/
APPS_SCRIPT_WEBAPP_URL="https://diyyourdata.com/workshop-api/"
# Shared secret. Same value as the SHARED_TOKEN Script Property (Apps Script) or
# /etc/workshop-api.env (self-hosted). Generate with: openssl rand -hex 32
APPS_SCRIPT_SHARED_TOKEN=""
# Optional: for clasp-based deploys
CLASP_SCRIPT_ID=""
# Self-hosted runtime only
WORKSHOP_API_PORT="8790"
GOOGLE_TOKEN_PATH="/root/.hermes/google_token.json"

# --- Vapi ------------------------------------------------------------------
VAPI_API_KEY=""
VAPI_ASSISTANT_ID=""            # filled by vapi/create-assistant.js
VAPI_PHONE_NUMBER_ID=""         # number to attach (free US number)
VAPI_SERVER_URL_OVERRIDE=""     # leave blank: tools call APPS_SCRIPT_WEBAPP_URL

# --- ElevenLabs ------------------------------------------------------------
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""          # chosen voice, see elevenlabs/voice-settings.json
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"

# --- Behaviour defaults (mirrored into Config tab) -------------------------
SLOT_GRANULARITY_MINUTES="30"
BOOKING_LEAD_TIME_HOURS="4"
MAX_DAYS_AHEAD="60"
BAYS_AVAILABLE="2"
BUFFER_MINUTES_BETWEEN_JOBS="15"

# --- Testing ---------------------------------------------------------------
TEST_PHONE_KNOWN="+61412345678"   # seeded test customer
TEST_BOOKING_ID=""
